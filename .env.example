PORT=5000
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rideflow?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

BCRYPT_SALT_ROUNDS=10

JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRE=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRE=30d

SUPER_ADMIN_EMAIL=admin@rideflow.com
SUPER_ADMIN_PASSWORD=SuperAdmin@12345

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_or_empty
